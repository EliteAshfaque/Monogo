# Database and app
DB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Media uploads
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxx

# Stripe: Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxxxxxxxxxxxxxx

# SMTP: use Resend SMTP, SendGrid SMTP, Mailgun SMTP, or Gmail app-password SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-api-key
EMAIL_FROM=Sonora <hello@example.com>
